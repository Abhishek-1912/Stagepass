# Copy to .env.local and fill in. All VITE_* values are public (shipped to the browser).
VITE_API_BASE_URL=http://localhost:8080
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<supabase anon / publishable key>
# Optional. Browser key for Maps Embed + Places; restrict to your site referrers in Google Cloud.
VITE_GOOGLE_MAPS_KEY=
